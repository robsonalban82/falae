  "exercise": {
    "instruction": "Complete com a forma certa do verbo to be.",
    "items": [
      {
        "prompt": "I ___ 30 years old.",
        "answer": "am",
        "hintPt": "Eu tenho 30 anos."
      },
      {
        "prompt": "My mom ___ at work.",
        "answer": "is",
        "hintPt": "Minha mãe está no trabalho."
      },
      {
        "prompt": "Ana and João ___ Brazilian.",
        "answer": "are",
        "hintPt": "Ana e João são brasileiros."
      },
      {
        "prompt": "The coffee ___ hot.",
        "answer": "isn't|is not",
        "hintPt": "negativa: o café não está quente."
      },
      {
        "prompt": "___ he at school?",
        "answer": "Is",
        "hintPt": "pergunta: ele está na escola?"
      }
