          "title": "O verbo vem primeiro",
          "lines": [
            {
              "en": "She **is** at home.",
              "pt": "Ela está em casa.",
              "emoji": "🏠"
            },
            {
              "en": "**Is** she at home?",
              "pt": "Ela está em casa?",
              "emoji": "🤔"
            }
          ]
        },
        {
          "tag": "exemplo",
          "art": "despertador",
          "lines": [
            {
              "en": "**Am** I late?",
              "pt": "Estou atrasado(a)?",
              "emoji": "⏰"
            },
            {
              "en": "**Is** it cold?",
              "pt": "Está frio?",
              "emoji": "🥶"
            },
            {
              "en": "**Are** you ready?",
              "pt": "Você está pronto(a)?",
              "emoji": "🎒"
            }
          ]
        },
        {
          "tag": "vocabulario",
          "lines": [
            {
              "en": "late",
              "pt": "atrasado(a)",
              "emoji": "⌛"
            },
            {
              "en": "ready",
              "pt": "pronto(a)",
              "emoji": "👍"
            }
          ]
        },
        {
          "tag": "regra",
          "title": "Respostas curtas",
          "lines": [
            {
              "en": "Are you ready? Yes, I **am**.",
              "pt": "Sim, estou.",
              "emoji": "🙆"
            },
            {
              "en": "Is she here? No, she **isn't**.",
              "pt": "Não, não está.",
              "emoji": "🙅"
            }
          ]
        },
        {
          "tag": "excecao",
          "lines": [
            {
              "wrong": "Yes, I'm.",
              "right": "Yes, I am."
            },
            {
              "note": "Resposta curta afirmativa: verbo inteiro."
            },
            {
              "en": "Yes, I **am**. · Yes, she **is**."
            }
          ],
          "figure": "⚠️"
        }
      ]
    },
    {
      "label": "Erro comum",
      "icon": "x",
