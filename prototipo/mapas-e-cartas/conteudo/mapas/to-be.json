{
  "id": "to-be",
  "title": "Verbo to be",
  "level": "A1",
  "figureStyle": "art",
  "collection": "mapas",
  "icon": "book",
  "center": {
    "en": "to be",
    "pt": "ser / estar"
  },
  "centerFigure": "🙋😊🏠",
  "centerArt": "to-be-centro",
  "intro": "O verbo mais usado do inglês. Comece pela afirmativa e vá girando o mapa.",
  "branches": [
    {
      "label": "Afirmativa",
      "icon": "check",
      "color": "folha",
      "figure": "😊",
      "nodes": [
        {
          "tag": "regra",
          "title": "Cada pessoa, uma forma",
          "lines": [
            {
              "en": "I **am**",
              "pt": "eu sou / estou",
              "emoji": "🙋"
            },
            {
              "en": "you **are**",
              "pt": "você é / está",
              "emoji": "👉"
            },
            {
              "en": "he / she / it **is**",
              "pt": "ele, ela é / está",
              "emoji": "🧍"
            },
            {
              "en": "we / you / they **are**",
              "pt": "nós somos/estamos, vocês/elas/eles são/estão",
              "emoji": "👫"
            }
          ]
        },
        {
          "tag": "exemplo",
          "lines": [
            {
              "en": "She **is** happy.",
              "pt": "Ela está feliz.",
              "emoji": "😊"
            },
            {
              "en": "We **are** friends.",
              "pt": "Nós somos amigos.",
              "emoji": "🤝"
            }
          ]
        },
        {
          "tag": "vocabulario",
          "lines": [
            {
              "en": "happy",
              "pt": "feliz",
              "emoji": "😄"
            },
            {
              "en": "friend",
              "pt": "amigo, amiga",
              "emoji": "👫"
            }
          ]
        }
      ]
    },
    {
      "label": "Contrações",
      "icon": "quote",
      "color": "manga",
      "figure": "✂️",
      "nodes": [
        {
          "tag": "regra",
          "title": "Pronome + to be, juntinhos",
          "lines": [
            {
              "en": "**I'm** · **you're**"
            },
            {
              "en": "**he's** · **she's** · **it's**"
            },
            {
              "en": "**we're** · **they're**"
            },
            {
              "note": "Na conversa, quase sempre contraído."
            }
          ],
          "figure": "✂️💬"
        },
        {
          "tag": "exemplo",
          "art": "escola",
          "lines": [
            {
              "en": "**I'm** Brazilian.",
              "pt": "Eu sou brasileiro(a).",
              "emoji": "🇧🇷"
            },
            {
              "en": "**They're** at school.",
              "pt": "Eles estão na escola.",
              "emoji": "🏫"
            }
          ]
        }
      ]
    },
    {
      "label": "Negativa",
      "icon": "ban",
      "color": "jabuticaba",
      "figure": "🚫",
      "nodes": [
        {
          "tag": "regra",
          "title": "to be + not",
          "lines": [
            {
              "en": "I am not = **I'm not**"
            },
            {
              "en": "is not = **isn't**"
            },
            {
              "en": "are not = **aren't**"
            }
          ],
          "figure": "🚫"
        },
        {
          "tag": "exemplo",
          "art": "braco-forte",
          "lines": [
            {
              "en": "He **isn't** tired.",
              "pt": "Ele não está cansado.",
              "emoji": "💪"
            },
            {
              "en": "They **aren't** here.",
              "pt": "Eles não estão aqui.",
              "emoji": "🪑"
            }
          ]
        }
      ]
    },
    {
      "label": "Perguntas",
      "icon": "question",
      "color": "anil",
      "figure": "🤔",
      "nodes": [
        {
          "tag": "regra",
