  "collection": "mapas",
  "center": {
    "en": "to be",
    "pt": "ser / estar"
  },
  "intro": "Em português são dois verbos; em inglês, um só. Comece pela afirmativa.",
  "doodle": "ser e estar: um verbo só!",
  "branches": [
    {
      "label": "Afirmativa",
      "icon": "check",
      "color": "folha",
      "nodes": [
        {
          "tag": "regra",
          "title": "Pronome + verbo",
          "lines": [
            {
              "en": "I **am**",
              "emoji": "🙋"
            },
            {
              "en": "you **are**",
              "emoji": "👉"
            },
            {
              "en": "he / she / it **is**",
              "emoji": "👫"
            },
            {
              "en": "we / you / they **are**",
              "emoji": "👨‍👩‍👧"
            }
          ],
          "figure": "📏"
        },
        {
          "tag": "exemplo",
          "lines": [
            {
              "en": "She **is** happy.",
              "pt": "Ela é feliz.",
              "emoji": "😊"
            },
            {
              "en": "We **are** friends.",
              "pt": "Nós somos amigos.",
              "emoji": "🤝"
            }
          ],
          "figure": "😄"
        },
        {
          "tag": "vocabulario",
          "lines": [
            {
              "en": "**happy**",
              "pt": "feliz",
              "emoji": "😄"
            },
            {
              "en": "**friend**",
              "pt": "amigo(a)",
              "emoji": "🧑‍🤝‍🧑"
            }
          ],
          "figure": "📒"
        }
      ]
    },
    {
      "label": "Negativa",
      "icon": "ban",
      "color": "jabuticaba",
      "nodes": [
        {
          "tag": "regra",
          "title": "to be + not",
          "lines": [
            {
              "en": "I am not → **I'm not**"
            },
            {
              "en": "is not → **isn't**"
            },
            {
              "en": "are not → **aren't**"
            }
          ],
          "figure": "🚫"
        },
        {
          "tag": "exemplo",
          "lines": [
            {
              "en": "He **isn't** tired.",
              "pt": "Ele não está cansado.",
              "emoji": "😴"
            },
            {
              "en": "They **aren't** here.",
              "pt": "Eles não estão aqui.",
              "emoji": "🚪"
            }
          ],
          "figure": "😴"
        },
        {
          "tag": "excecao",
          "lines": [
            {
              "wrong": "I amn't",
              "right": "I'm not"
            },
            {
              "note": "Com \"I\", só existe a contração I'm not."
            }
          ],
          "figure": "🤯"
        }
      ]
    },
    {
      "label": "Perguntas",
      "icon": "question",
      "color": "anil",
      "nodes": [
        {
          "tag": "regra",
          "title": "O verbo vem primeiro",
          "lines": [
            {
              "en": "She is → **Is** she...?"
            }
          ],
          "figure": "🔄"
        },
        {
          "tag": "exemplo",
          "lines": [
            {
              "en": "**Am** I late?",
              "emoji": "⏰"
            },
            {
              "en": "**Is** she at home?",
              "emoji": "🏠"
            },
            {
              "en": "**Are** you ready?",
              "emoji": "🎒"
            }
          ],
          "figure": "🙋"
        },
        {
          "tag": "regra",
          "title": "Respostas curtas",
          "lines": [
            {
              "en": "Yes, I **am**."
            },
            {
              "en": "No, she **isn't**."
            }
          ],
          "figure": "💬"
        },
        {
          "tag": "excecao",
          "lines": [
            {
              "wrong": "Yes, I'm.",
              "right": "Yes, I am."
            },
            {
              "note": "Na resposta curta afirmativa não se contrai."
            }
          ],
          "figure": "❗"
        },
        {
          "tag": "vocabulario",
          "lines": [
            {
              "en": "**late**",
              "pt": "atrasado",
              "emoji": "⏰"
            },
            {
              "en": "**ready**",
              "pt": "pronto",
              "emoji": "✅"
            }
          ],
          "figure": "📒"
        }
      ]
    },
